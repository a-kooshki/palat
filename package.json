{
  "name": "stone-inventory-management",
  "version": "1.0.0",
  "description": "Stone Inventory Management System for stone processing factories and warehouses",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run start:electron\" \"npm run start:react\"",
    "start:electron": "wait-on http://localhost:3000 && electron .",
    "start:react": "react-scripts start",
    "build": "react-scripts build",
    "build:electron": "npm run build && electron-builder",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "sqlite3": "^5.1.7",
    "wait-on": "^7.0.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "electron-builder": "^24.9.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.stone.inventory",
    "productName": "Stone Inventory Management",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "renderer/public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "renderer/public/icon.ico",
      "uninstallerIcon": "renderer/public/icon.ico",
      "installerHeaderIcon": "renderer/public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "StoneInventory-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "renderer/public/icon.png",
        "to": "icon.png"
      }
    ]
  },
  "homepage": ".",
  "private": true
}
